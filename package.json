{
  "name": "ps5-quiet",
  "version": "1.0.1",
  "description": "One-button PS5 GPU clock reapply for the hot-idle workaround",
  "type": "module",
  "scripts": {
    "build": "rollup -c --forceExit",
    "typecheck": "tsc --noEmit",
    "test": "PYTHONPATH=py_modules python3 -m unittest discover -s tests -v",
    "package": "python3 scripts/package.py"
  },
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router": "^5.1.20",
    "rollup": "^4.53.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.16.0",
    "react-icons": "^5.7.0",
    "tslib": "^2.8.1"
  },
  "author": "honkhonk-mi",
  "repository": {
    "type": "git",
    "url": "https://github.com/honkhonk-mi/ps5-quiet.git"
  },
  "homepage": "https://github.com/honkhonk-mi/ps5-quiet",
  "bugs": {
    "url": "https://github.com/honkhonk-mi/ps5-quiet/issues"
  }
